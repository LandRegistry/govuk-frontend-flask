{
  "name": "govuk-frontend-flask",
  "version": "1.0.0",
  "description": "GOV.UK Frontend Flask",
  "private": true,
  "scripts": {
    "format:check": "prettier src --check",
    "format:fix": "prettier src --write",
    "lint:check": "eslint src",
    "lint:fix": "eslint src --fix",
    "prebuild": "npm run format:check && npm run lint:check",
    "build": "webpack",
    "watch": "webpack --watch",
    "upgrade:latest": "ncu -u",
    "upgrade:minor": "ncu -t minor -u",
    "upgrade:patch": "ncu -t patch -u"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LandRegistry/govuk-frontend-flask.git"
  },
  "author": {
    "name": "Matt Shaw",
    "url": "https://matthew-shaw.github.io/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LandRegistry/govuk-frontend-flask/issues"
  },
  "homepage": "https://github.com/LandRegistry/govuk-frontend-flask#readme",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "govuk-frontend": "5.14.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.3",
    "css-minimizer-webpack-plugin": "^7.0.4",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "mini-css-extract-plugin": "^2.10.0",
    "npm-check-updates": "^19.3.2",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^11.1.3",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  }
}
